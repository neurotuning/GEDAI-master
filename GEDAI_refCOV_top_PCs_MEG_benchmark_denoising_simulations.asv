contourf(X, Y, mean_GEDAI_SNR_matrix, 30);
colorbar;
xlabel('SSI top PCs');
ylabel('refCOV top PCs');
title(sprintf('Mean GEDAI SNR (Contamination=%d%%, SNR=%d dB)', contaminated_signal_proportion(c), signal_to_noise_in_db(n)));


